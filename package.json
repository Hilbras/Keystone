{
  "name": "@hilbras/keystone",
  "engines": {
    "node": ">=22"
  },
  "version": "3.5.4",
  "license": "MIT",
  "description": "Hilbras Keystone — standalone identity platform: authentication, MFA, authorization, enterprise SSO, SCIM, and token issuance.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hilbras/Keystone.git"
  },
  "homepage": "https://github.com/Hilbras/Keystone#readme",
  "bugs": {
    "url": "https://github.com/Hilbras/Keystone/issues"
  },
  "type": "module",
  "overrides": {
    "esbuild": ">=0.25.0"
  },
  "files": [
    "dist",
    "!dist/tests",
    "docs",
    "CHANGELOG.md",
    "README.md"
  ],
  "bin": {
    "keystone": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:setup": "KEYSTONE_SETUP_MODE=true tsx watch src/setup-server.ts",
    "dev:all": "./start.sh",
    "build": "npm run clean && tsc && npm run copy:migrations",
    "build:sdk": "cd packages/keystone-sdk && npm run build",
    "build:all": "npm run build:sdk && npm run build && cd frontend && npm run build",
    "copy:migrations": "mkdir -p dist/db/migrations && cp -r src/db/migrations/* dist/db/migrations/",
    "start": "node dist/index.js",
    "start:setup": "KEYSTONE_SETUP_MODE=true node dist/setup-server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src packages scripts --deny-warnings",
    "verify:release": "node scripts/verify-release-metadata.mjs",
    "typecheck:all": "npm run typecheck && cd frontend && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:reencrypt-oidc-secrets": "node dist/db/reencryptOidcSecrets.js",
    "test": "LOGIN_MAX_ATTEMPTS=1000000 LOGIN_PER_ADDRESS_MAX=1000000 LOGIN_WINDOW_SECONDS=60 GLOBAL_RATE_LIMIT_MAX=1000000 GLOBAL_RATE_LIMIT_WINDOW=60 SCIM_AUTH_FAILURE_MAX=1000000 SCIM_AUTH_FAILURE_WINDOW_SECONDS=60 SCIM_RATE_LIMIT_MAX=1000000 SCIM_RATE_LIMIT_WINDOW_SECONDS=60 node --test --test-force-exit --test-concurrency=1 --test-timeout=60000 dist/tests/*.test.js dist/tests/*/*.test.js dist/tests/*/*/*.test.js dist/tests/*/*/*/*.test.js",
    "test:security": "LOGIN_MAX_ATTEMPTS=1000000 LOGIN_PER_ADDRESS_MAX=1000000 LOGIN_WINDOW_SECONDS=60 GLOBAL_RATE_LIMIT_MAX=1000000 GLOBAL_RATE_LIMIT_WINDOW=60 SCIM_AUTH_FAILURE_MAX=1000000 SCIM_AUTH_FAILURE_WINDOW_SECONDS=60 SCIM_RATE_LIMIT_MAX=1000000 SCIM_RATE_LIMIT_WINDOW_SECONDS=60 node --test --test-force-exit --test-concurrency=1 --test-timeout=60000 dist/tests/security/*.test.js dist/tests/security/*/*.test.js dist/tests/security/*/*/*.test.js dist/tests/security/*/*/*/*.test.js",
    "test:all": "npm test && cd frontend && npm run test:e2e",
    "setup": "./install.sh",
    "start:all": "./start.sh",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "registry:check": "node scripts/verify-security-registry.mjs",
    "registry:render": "node scripts/render-security-registry.mjs",
    "reaudit:check": "node scripts/render-reaudit-matrix.mjs --check",
    "reaudit:render": "node scripts/render-reaudit-matrix.mjs",
    "review:api": "node scripts/review-api-surface.mjs",
    "verify:k8s": "node scripts/verify-k8s-manifests.mjs",
    "dashboard:auth": "node scripts/generate-auth-dashboard.mjs",
    "verify:doc-samples": "node scripts/verify-doc-samples.mjs",
    "verify:doc-scripts": "node scripts/verify-doc-scripts.mjs",
    "verify:secrets-cipher": "node scripts/verify-secrets-cipher.mjs",
    "verify:sdk": "node scripts/verify-sdk-packages.mjs",
    "verify:action-pins": "node scripts/verify-action-pins.mjs",
    "verify:action-pin-versions": "node scripts/verify-action-pin-versions.mjs",
    "verify:node": "node scripts/verify-node-version.mjs",
    "verify:changelog": "node scripts/verify-changelog.mjs",
    "bump:version": "node scripts/bump-version.mjs",
    "sync:sdk": "node scripts/sync-sdk-versions.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "plans:record": "node scripts/record-query-plans.mjs",
    "bench:hot": "npm run build && node dist/bench/hotPaths.js",
    "verify:image": "node scripts/verify-image-hygiene.mjs"
  },
  "dependencies": {
    "@authenio/samlify-node-xmllint": "^2.0.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@simplewebauthn/server": "^14.0.2",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.8",
    "commander": "^15.0.0",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "otpauth": "^9.5.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.4",
    "prom-client": "^15.1.3",
    "samlify": "^2.13.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@peculiar/x509": "^2.1.0",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10",
    "light-my-request": "^6.0.0",
    "oxlint": "^1.85.0",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.15.0",
    "typescript": "^7.0.2"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "types": "./dist/index.d.ts"
}
