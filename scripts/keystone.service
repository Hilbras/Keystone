[Unit]
Description=Hilbras Keystone Identity Platform
Documentation=https://github.com/Hilbras-dev/Hilbras-Keystone
Requires=docker.service
After=docker.service network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/hilbras-keystone
Environment="COMPOSE_PROJECT_NAME=hilbras-keystone"
ExecStart=/usr/bin/docker compose -f docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.yml down
ExecReload=/usr/bin/docker compose -f docker-compose.yml up -d --build
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
